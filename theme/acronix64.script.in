# Acronix 64: Nintendo 64 / Smash 64 style boot splash.
# The constants above this point (LOGO_W, PIECE_*, PANEL_L*, TITLE_*, DIG_PAD)
# are generated by scripts/make_assets64.sh, which prepends them to this file.
#
# Storyboard (seconds from the moment the splash appears):
#   0.0  CRT turn-on: a white line opens into a full flash, the diamond
#        background scrolls in under scanlines and a vignette.
#   0.5  Scene 1, UNI intro: the character-select frame drops in and bounces,
#        then the three blue 3D logo blocks zoom in from the "camera" and slam
#        onto it. Speed lines, impact flash, shake, comic burst, sparkles, a
#        "P1" tag and the tagline name plate.
#   3.2  Transition, versus screen: a red slab and a blue slab slam together
#        from both sides with a burst at the seam; the scene is swapped while
#        they cover the screen (logo group moves to the top, background gets a
#        purple wash), then they slide away.
#   3.8  Scene 2: the letters of ACRONIXOS zoom in one by one, the group plate
#        stamps in from the right, and the boot progress shows as a Smash style
#        damage percent that changes colour as it climbs.
#   After that everything idles (scrolling background, hop wave, sparkles)
#   until Plymouth tells us the boot is over.
#
# All coordinates are written for a 1920x1080 screen and multiplied by `k`.

FPS = 50;                # Plymouth calls the refresh function about 50 times per second

# ---- timeline ---------------------------------------------------------------
CRT_END = 0.35;
PANEL_T0 = 0.50;  PANEL_TIME = 0.55;
PIECE_T0 = 0.85;  PIECE_STAGGER = 0.18;  PIECE_FLY = 0.60;
T_IMP = PIECE_T0 + 2 * PIECE_STAGGER + PIECE_FLY;     # last block lands
PLATE_T0 = T_IMP + 0.25;
TR_T0 = T_IMP + 1.40;    # versus wipe starts
TR_CLOSE = 0.26;         # slabs slam shut
TR_HOLD = 0.16;          # fully closed
TR_OPEN = 0.34;          # slabs slide away
T_SWAP = TR_T0 + TR_CLOSE;
TITLE_T0 = T_SWAP + TR_HOLD + 0.10;
LETTER_STAGGER = 0.07;
LETTER_TIME = 0.30;
TITLE_END = TITLE_T0 + (TITLE_N - 1) * LETTER_STAGGER + LETTER_TIME;
BADGE_T0 = TITLE_END - 0.10;
BADGE_TIME = 0.45;
COUNTER_T0 = BADGE_T0 + 0.40;
HOP_DELAY = 1.0;  HOP_PERIOD = 4.0;

# ---- screen and scale -----------------------------------------------------
sw = Window.GetWidth();
sh = Window.GetHeight();
k = Math.Min(sw / 1920, sh / 1080);      # design units -> pixels (keeps proportions)
kc = Math.Max(sw / 1920, sh / 1080);     # same, but for things that must cover the screen
GS = 0.95;                               # extra scale of the logo group
sc = k * GS;
Window.SetBackgroundTopColor(0.04, 0.08, 0.28);
Window.SetBackgroundBottomColor(0.02, 0.04, 0.15);

# ---- helpers ----------------------------------------------------------------
# Scales an image once at load time; images that are already the right size
# (a scale of 1) are used as they are, which saves boot time and memory.
fun load_img(file, s)
{
    local.im = Image(file);
    if (Math.Abs(s - 1) < 0.01) return local.im;
    return local.im.Scale(Math.Max(Math.Int(local.im.GetWidth() * s), 1),
                          Math.Max(Math.Int(local.im.GetHeight() * s), 1));
}

# full-screen images made for 1080p: used as they are when the screen is 1080p
fun load_fit(file)
{
    local.im = Image(file);
    if (local.im.GetWidth() == sw && local.im.GetHeight() == sh) return local.im;
    return local.im.Scale(sw, sh);
}

fun make_sprite(img, z)
{
    local.sp = Sprite(img);
    local.sp.SetZ(z);
    local.sp.SetOpacity(0);
    return local.sp;
}

fun clamp01(v)
{
    return Math.Max(Math.Min(v, 1), 0);
}

# Plymouth repaints a sprite's whole area every time ANY setter is called on it,
# even with the same value, and software compositing at 1080p is the slowest
# thing in this theme. So every per-frame update goes through these helpers,
# which only call the real setter when the value actually changed. Each sprite
# has a fixed number `n` (see the list where the sprites are created).
for (i = 0; i < 48; i++) { last_x[i] = -99999; last_y[i] = -99999; last_o[i] = -1; last_key[i] = -1; }

fun put(sp, n, x, y)
{
    local.xi = Math.Int(x);
    local.yi = Math.Int(y);
    if (local.xi != last_x[n] || local.yi != last_y[n]) {
        sp.SetX(local.xi);
        sp.SetY(local.yi);
        last_x[n] = local.xi;
        last_y[n] = local.yi;
    }
}

fun alpha(sp, n, v)
{
    local.q = Math.Int(Math.Max(Math.Min(v, 1), 0) * 50);       # 50 steps is plenty
    if (local.q != last_o[n]) {
        sp.SetOpacity(local.q / 50);
        last_o[n] = local.q;
    }
}

# swap the image only when `key` changes (key identifies which picture it is)
fun face(sp, n, key, im)
{
    if (key != last_key[n]) {
        sp.SetImage(im);
        last_key[n] = key;
    }
}

fun ease_out_back(t)
{
    local.u = t - 1;
    return 1 + 2.70158 * local.u * local.u * local.u + 1.70158 * local.u * local.u;
}

fun ease_out_bounce(t)
{
    if (t < 1 / 2.75) return 7.5625 * t * t;
    if (t < 2 / 2.75) { t -= 1.5 / 2.75;    return 7.5625 * t * t + 0.75; }
    if (t < 2.5 / 2.75) { t -= 2.25 / 2.75; return 7.5625 * t * t + 0.9375; }
    t -= 2.625 / 2.75;
    return 7.5625 * t * t + 0.984375;
}

# ---- background: scrolling diamond lattice -----------------------------------
# bg.png is 9x9 tiles of 240x135 (native 1080p); the picture is one tile larger than
# the screen and slides by exactly one tile before wrapping, so the loop is seamless.
bg_s = kc;
bg_img = load_img("bg.png", bg_s);
bg_px = 240 * bg_s;
bg_py = 135 * bg_s;
bg2_img = load_img("bg2.png", bg_s);                          # purple twin, used after the wipe
bg = make_sprite(bg_img, 1);

# CRT overlay (scanlines + dark corners in one layer: every extra full-screen
# layer costs frame time, and the whole timeline is counted in frames)
crt_overlay = make_sprite(load_fit("crt.png"), 150);
crt_overlay.SetOpacity(1);

# CRT turn-on: white line that opens vertically (pre-scaled steps, no per-frame scaling)
crt_h[0] = 3;  crt_h[1] = 8;  crt_h[2] = 30;  crt_h[3] = 120;  crt_h[4] = 440;  crt_h[5] = sh;
for (i = 0; i < 6; i++) {
    crt_img[i] = Image("flash.png").Scale(sw, Math.Min(Math.Int(crt_h[i] * k) + 2, sh));
}
crt = make_sprite(crt_img[0], 140);

# speed lines, impact flash
lines_a = load_fit("lines_a.png");
lines_b = load_fit("lines_b.png");
lines = make_sprite(lines_a, 3);
flash = make_sprite(Image("flash.png").Scale(sw, sh), 120);

# ---- logo group: frame, blocks, P1 tag, tagline plate ------------------------
panel_img = load_img("panel.png", sc);
panel_w = panel_img.GetWidth() - 18 * sc;      # frame without its hard shadow
panel_h = panel_img.GetHeight() - 18 * sc;
panel_x = (sw - panel_w) / 2;
panel = make_sprite(panel_img, 5);

plate_img = load_img("plate_tag.png", sc);
plate_x = (sw - plate_img.GetWidth()) / 2;
plate_dy = panel_h - 10 * sc;                  # plate sits just under the frame
plate = make_sprite(plate_img, 11);
stack_h = plate_dy + plate_img.GetHeight() - 16 * sc;    # frame + plate

GY1 = (sh - stack_h) / 2;                      # scene 1: the group is centred
GY2 = 36 * k;                                  # scene 2: it sits at the top
gy = GY1;

p1_img = load_img("tag_p1.png", sc);
p1 = make_sprite(p1_img, 12);

fun load_piece64(file, px, py, from_x, from_y, spin, delay)
{
    po.img = load_img(file, sc);
    po.z0 = load_img(file, sc * 1.9);     # three pre-scaled copies: the block "arrives" in steps
    po.z1 = load_img(file, sc * 1.6);
    po.z2 = load_img(file, sc * 1.3);
    po.sprite = make_sprite(po.img, 10);
    po.rx = (PANEL_LX + px) * sc;         # offset from the frame's top-left corner
    po.ry = (PANEL_LY + py) * sc;
    po.fx = from_x;
    po.fy = from_y;
    po.spin = spin;
    po.delay = delay;
    return po;
}
pieces[0] = load_piece64("piece_u.png",   PIECE_U_X,   PIECE_U_Y,
                         -sw * 0.35, GY1 + panel_h * 0.4,           0, PIECE_T0);
pieces[1] = load_piece64("piece_n.png",   PIECE_N_X,   PIECE_N_Y,
                         panel_x + panel_w * 0.5, sh * 1.25,        0, PIECE_T0 + PIECE_STAGGER);
pieces[2] = load_piece64("piece_dot.png", PIECE_DOT_X, PIECE_DOT_Y,
                         sw * 1.2, -sh * 0.3,                       0, PIECE_T0 + 2 * PIECE_STAGGER);
piece_landed[0] = 0;  piece_landed[1] = 0;  piece_landed[2] = 0;
for (i = 0; i < 12; i++) letter_landed[i] = 0;

# comic burst behind the logo blocks
burst_img = Image("burst.png");
burst_w = panel_w * 1.45;
burst_v[0] = burst_img.Scale(Math.Int(burst_w * 0.55), Math.Int(burst_w * 0.55));   # grows in 3 steps
burst_v[1] = burst_img.Scale(Math.Int(burst_w * 0.95), Math.Int(burst_w * 0.95));
burst_v[2] = burst_img.Scale(Math.Int(burst_w * 1.25), Math.Int(burst_w * 1.25));
seam_v[0] = burst_img.Scale(Math.Int(kc * 480), Math.Int(kc * 480));
seam_v[1] = burst_img.Scale(Math.Int(kc * 820), Math.Int(kc * 820));
seam_v[2] = burst_img.Scale(Math.Int(kc * 1150), Math.Int(kc * 1150));
burst = make_sprite(burst_img, 8);
seam_burst = make_sprite(burst_img, 62);

# sparkles: 0-3 around the frame, 4-7 around the title
spark_big = load_img("spark_big.png", k * 0.9);
spark_small = load_img("spark_small.png", k * 0.9);
for (i = 0; i < 8; i++) sparks[i] = make_sprite(spark_small, 20);

# ---- versus slabs --------------------------------------------------------------
slab_red_img = load_img("slab_red.png", kc);
slab_blue_img = load_img("slab_blue.png", kc);
slab_red = make_sprite(slab_red_img, 60);
slab_blue = make_sprite(slab_blue_img, 61);
slab_y = (sh - slab_red_img.GetHeight()) / 2;
# closed: seam at the screen centre (design x 1055..1075 of a 1920 screen)
red_closed = sw / 2 - 1155 * kc;
blue_closed = sw / 2 - 75 * kc;
red_open = red_closed - 1400 * kc;
blue_open = blue_closed + 1400 * kc;

# ---- project name: ACRONIXOS ------------------------------------------------------
ts = Math.Min(sw * 0.46 / TITLE_TOTAL, sh * 0.13 / (TITLE_IMG_H - 2 * TITLE_PAD));
title_x = (sw - TITLE_TOTAL * ts) / 2;
title_y = GY2 + stack_h + 34 * k - TITLE_PAD * ts;       # image top; letters sit under the tagline
title_bottom = title_y + (TITLE_IMG_H - TITLE_PAD) * ts;

fun make_letter(i, x)
{
    lett.img = load_img("title_" + i + ".png", ts);
    lett.z0 = load_img("title_" + i + ".png", ts * 2.2);     # zoom steps, see refresh()
    lett.z1 = load_img("title_" + i + ".png", ts * 1.7);
    lett.z2 = load_img("title_" + i + ".png", ts * 1.3);
    lett.sprite = make_sprite(lett.img, 14);
    lett.cx = x + lett.img.GetWidth() / 2;         # centre, so it can zoom around it
    lett.cy = title_y + lett.img.GetHeight() / 2;
    return lett;
}
cursor = title_x;
for (i = 0; i < TITLE_N; i++) {
    letters[i] = make_letter(i, cursor - TITLE_PAD * ts);
    cursor += TITLE_ADV[i] * ts;
}

# group plate: stamps in from the right
badge_img0 = Image("badge.png");
bs = TITLE_TOTAL * ts * 0.88 / badge_img0.GetWidth();
badge_img = load_img("badge.png", bs);
badge_tx = (sw - badge_img.GetWidth()) / 2;
badge_y = title_bottom + 4 * k - 16 * bs;
badge = make_sprite(badge_img, 14);

# ---- damage counter: boot progress as a percent ---------------------------------------
cs = k * 0.62;
for (st = 0; st < 4; st++) {
    for (d = 0; d < 10; d++) dig_img[st * 11 + d] = load_img("dig" + st + "_" + d + ".png", cs);
    dig_img[st * 11 + 10] = load_img("dig" + st + "_pct.png", cs);
}
label_img = load_img("label.png", k * 0.8);
label = make_sprite(label_img, 15);
label.SetX((sw - label_img.GetWidth()) / 2);
label_y = badge_y + badge_img.GetHeight() - 14 * k;
label.SetY(label_y);
digits_y = label_y + label_img.GetHeight() - 16 * k;
for (i = 0; i < 4; i++) digit_sprites[i] = make_sprite(dig_img[0], 15);
target = 0;       # percent reported by Plymouth
shown = 0;        # percent on screen (eases towards the target)
shown_last = -1;

# Redraws the digits only when the whole-number percent changes (at most 100 times
# per boot); the fade-in goes through alpha(), which skips unchanged values.
digit_count = 0;
fun update_counter()
{
    local.n = Math.Int(shown);
    if (local.n > 100) local.n = 100;
    if (local.n != shown_last) {
        shown_last = local.n;
        local.stage = 0;
        if (local.n >= 35) local.stage = 1;
        if (local.n >= 65) local.stage = 2;
        if (local.n >= 90) local.stage = 3;
        local.count = 1;
        gl[0] = local.n;
        if (local.n >= 100) { gl[0] = 1; gl[1] = 0; gl[2] = 0; local.count = 3; }
        else if (local.n >= 10) { gl[0] = Math.Int(local.n / 10); gl[1] = local.n - gl[0] * 10; local.count = 2; }
        gl[local.count] = 10;                           # the "%" sign comes last
        local.count++;
        local.total = 0;
        for (local.j = 0; local.j < local.count; local.j++) {
            local.im = dig_img[local.stage * 11 + gl[local.j]];
            local.total += local.im.GetWidth() - 2 * DIG_PAD * cs + 2 * k;
        }
        local.x = (sw - local.total) / 2 - DIG_PAD * cs;
        for (local.j = 0; local.j < local.count; local.j++) {
            local.im = dig_img[local.stage * 11 + gl[local.j]];
            face(digit_sprites[local.j], 25 + local.j, local.stage * 11 + gl[local.j], local.im);
            put(digit_sprites[local.j], 25 + local.j, local.x, digits_y);
            local.x += local.im.GetWidth() - 2 * DIG_PAD * cs + 2 * k;
        }
        digit_count = local.count;
    }
    for (local.j = 0; local.j < 4; local.j++) {
        if (local.j < digit_count) alpha(digit_sprites[local.j], 25 + local.j, counter_alpha);
        else alpha(digit_sprites[local.j], 25 + local.j, 0);
    }
    return 0;
}
counter_alpha = 0;

# ---- the animation ------------------------------------------------------------------
# Sprite numbers used with put/alpha/face:
#  0 background   1 CRT line    2 speed lines  3 flash        4 frame      5-7 logo blocks
#  8 burst        9 seam burst  10 P1 tag      11 tagline     12 red slab  13 blue slab
#  14-22 letters  23 group plate  24 counter label  25-28 counter digits  29-36 sparkles
frame = 0;
bg_swapped = 0;

fun refresh()
{
    time = frame / FPS;
    frame++;

    # N64 games ran at ~20-30 fps, and every update repaints parts of a 1080p screen
    # in software, so the scene is only updated on every second tick (25 per second).
    # `time` still advances with every tick, so the timeline keeps its speed.
    if (frame % 2 == 0) return 0;

    # Interpreting this function is itself slow, so every section only runs while it
    # can still change something (its time window); afterwards it costs nothing.
    w_crt = time < CRT_END + 0.4;
    w_grp = (time >= PANEL_T0 - 0.05 && time < T_IMP + 1.0) || (time >= T_SWAP - 0.05 && time < T_SWAP + 0.5);
    w_wipe = time >= TR_T0 - 0.05 && time < TR_T0 + TR_CLOSE + TR_HOLD + TR_OPEN + 0.1;
    wave = time - TITLE_END - HOP_DELAY;
    if (wave >= 0) wave = wave - Math.Int(wave / HOP_PERIOD) * HOP_PERIOD;
    w_title = (time >= TITLE_T0 - 0.05 && time < TITLE_END + 0.4) || (time >= TITLE_END + HOP_DELAY && wave < 1.2);
    w_badge = time >= BADGE_T0 - 0.05 && time < BADGE_T0 + BADGE_TIME + 0.45;

    # ---- CRT turn-on --------------------------------------------------------------
    if (w_crt) {
        ci = Math.Min(Math.Int(time / 0.065), 5);
        face(crt, 1, ci, crt_img[ci]);
        put(crt, 1, 0, (sh - crt_img[ci].GetHeight()) / 2);
        if (time < CRT_END) alpha(crt, 1, 1);
        else if (time < CRT_END + 0.10) alpha(crt, 1, 0.65);      # white flash fades out in 3 steps
        else if (time < CRT_END + 0.20) alpha(crt, 1, 0.3);
        else alpha(crt, 1, 0);
    } else {
        alpha(crt, 1, 0);
    }
    if (w_crt) {
        bg_on = 0;
        if (time >= CRT_END - 0.03) bg_on = 1;
        alpha(bg, 0, bg_on);
    }

    # Background scrolls diagonally by one tile every 7 seconds, then wraps. Repainting
    # the whole screen is the most expensive thing we do (about 40 ms at 1080p in
    # software), so it only steps 4 times a second and stops once the title is in;
    # the stepped motion suits the console look anyway.
    if (time < TITLE_END && frame % 12 == 1) {
        u = time / 7;
        u = u - Math.Int(u);
        put(bg, 0, -bg_px + u * bg_px, -bg_py + u * bg_py);
    }

    # ---- scene bookkeeping --------------------------------------------------------------
    if (time >= T_SWAP) {
        gy = GY2;
        if (!bg_swapped) {
            face(bg, 0, 5, bg2_img);                              # purple lattice for scene 2
            bg_swapped = 1;
        }
    } else {
        gy = GY1;
    }

    # ---- shake: the impact, the wipe slam and the last letter ------------------------
    shx = 0;
    shy = 0;
    d1 = time - T_IMP;
    if (d1 >= 0 && d1 < 0.45) {
        a = sh * 0.016 * (1 - d1 / 0.45);
        shx += a * Math.Sin(d1 * 90);  shy += a * Math.Cos(d1 * 110);
    }
    d2 = time - T_SWAP;
    if (d2 >= 0 && d2 < 0.35) {
        a = sh * 0.014 * (1 - d2 / 0.35);
        shx += a * Math.Sin(d2 * 100);  shy += a * Math.Cos(d2 * 80);
    }
    d3 = time - TITLE_END;
    if (d3 >= 0 && d3 < 0.30) {
        a = sh * 0.009 * (1 - d3 / 0.30);
        shx += a * Math.Sin(d3 * 95);  shy += a * Math.Cos(d3 * 120);
    }

    # ---- speed lines before the impact, flickering between two drawings -----------------
    if (time < T_IMP + 0.1) {
        alpha(lines, 2, (time - (T_IMP - 0.6)) / 0.3);
        if (Math.Int(frame / 4) % 2 == 0) face(lines, 2, 0, lines_a);
        else face(lines, 2, 1, lines_b);
        if (time >= T_IMP) alpha(lines, 2, 0);
    }

    if (w_grp) {
        # ---- frame drops in with a bounce ------------------------------------------------------
        pt = clamp01((time - PANEL_T0) / PANEL_TIME);
        drop = (1 - ease_out_bounce(pt)) * (gy + panel_img.GetHeight() + 20 * k);
        if (time >= PANEL_T0) alpha(panel, 4, 1);
        put(panel, 4, panel_x + shx, gy - drop + shy);

        # ---- the three blocks zoom in from the camera and slam down -------------------------------
        for (i = 0; i < 3; i++) {
            p = pieces[i];
            tt = clamp01((time - p.delay) / PIECE_FLY);
            tx = panel_x + p.rx;
            ty = gy + p.ry;
            if (time >= p.delay) alpha(p.sprite, 5 + i, 1);
            if (tt < 1) {
                e = tt * tt;                                   # accelerates into the slam
                x = p.fx + (tx - p.fx) * e;
                y = p.fy + (ty - p.fy) * e;
                zs = Math.Int(e * 3);                          # which pre-scaled copy: far, middle, near
                if (zs == 0) img = p.z0;
                else if (zs == 1) img = p.z1;
                else img = p.z2;
                cx = x + p.img.GetWidth() / 2;
                cy = y + p.img.GetHeight() / 2;
                face(p.sprite, 5 + i, zs, img);
                put(p.sprite, 5 + i, cx - img.GetWidth() / 2 + shx, cy - img.GetHeight() / 2 + shy);
            } else {
                face(p.sprite, 5 + i, -2, p.img);
                put(p.sprite, 5 + i, tx + shx, ty + shy);
            }
        }

        # ---- impact effects --------------------------------------------------------------------------
        dI = time - T_IMP;
        f1 = 0;                                          # full-screen white: 3 steps only
        if (dI >= 0 && dI < 0.08) f1 = 1;
        else if (dI >= 0.08 && dI < 0.16) f1 = 0.5;
        else if (dI >= 0.16 && dI < 0.24) f1 = 0.2;
        alpha(flash, 3, f1);

        # comic burst: pops out and fades
        bb = 1;
        if (dI >= 0) bb = clamp01(dI / 0.55);
        if (dI >= 0 && bb < 1 && time < T_SWAP) {
            bi = Math.Int(bb * 3);                           # grows in 3 steps, fading as it goes
            bw = burst_v[bi].GetWidth();
            face(burst, 8, bi, burst_v[bi]);
            put(burst, 8, panel_x + panel_w / 2 - bw / 2 + shx, gy + panel_h / 2 - bw / 2 + shy);
            alpha(burst, 8, 1 - bi * 0.3);
        } else {
            alpha(burst, 8, 0);
        }

        # "P1" tag pops in above the frame's corner, tagline plate slides up from below
        if (dI >= 0.08) {
            pe = ease_out_back(clamp01((dI - 0.08) / 0.35));
            alpha(p1, 10, 1);
            put(p1, 10, panel_x - 22 * k + shx, gy - 26 * k - (1 - pe) * 120 * k + shy);
        }
        if (time >= PLATE_T0) {
            pl = ease_out_back(clamp01((time - PLATE_T0) / 0.45));
            plate_ty = gy + plate_dy;
            alpha(plate, 11, 1);
            put(plate, 11, plate_x + shx, sh + (plate_ty - sh) * pl + shy);
        }
    }

    if (w_wipe) {
        # ---- versus wipe ---------------------------------------------------------------------------------
        tr = time - TR_T0;
        c = 0;
        if (tr > 0) {
            if (tr <= TR_CLOSE + TR_HOLD) {
                q = clamp01(tr / TR_CLOSE);
                c = q * q;                                    # slabs accelerate into each other
            } else {
                q = clamp01((tr - TR_CLOSE - TR_HOLD) / TR_OPEN);
                c = 1 - q * q;
            }
        }
        if (c > 0.001) {
            alpha(slab_red, 12, 1);
            alpha(slab_blue, 13, 1);
            put(slab_red, 12, red_open + (red_closed - red_open) * c, slab_y);
            put(slab_blue, 13, blue_open + (blue_closed - blue_open) * c, slab_y);
        } else {
            alpha(slab_red, 12, 0);
            alpha(slab_blue, 13, 0);
        }
        # burst at the seam when the slabs hit, plus a white flash
        f2 = 0;
        dS = time - T_SWAP;
        if (dS >= -0.02 && dS < 0.5) {
            sb = clamp01((dS + 0.02) / 0.5);
            si = Math.Min(Math.Int(sb * 3), 2);              # three pre-scaled sizes
            sz = seam_v[si].GetWidth();
            face(seam_burst, 9, si, seam_v[si]);
            put(seam_burst, 9, sw / 2 - sz / 2, sh / 2 - sz / 2);
            alpha(seam_burst, 9, 1 - si * 0.3);
            if (dS < 0.06) f2 = 0.9;                         # white flash, 3 steps
            else if (dS < 0.14) f2 = 0.45;
            else if (dS < 0.22) f2 = 0.15;
        } else {
            alpha(seam_burst, 9, 0);
        }
        alpha(flash, 3, f2);
    }

    if (w_title) {
        # ---- project name: letters zoom in from the camera one after another ------------------------
        for (i = 0; i < TITLE_N; i++) {
            ln = letters[i];
            lt = (time - TITLE_T0 - i * LETTER_STAGGER) / LETTER_TIME;
            if (lt > 0) {
                lq = clamp01(lt);
                ly = ln.cy;
                lx = ln.cx;
                if (lq < 1) {
                    le = lq * lq;
                    lzs = Math.Int(le * 3);                  # far, middle, near copy
                    if (lzs == 0) limg = ln.z0;
                    else if (lzs == 1) limg = ln.z1;
                    else limg = ln.z2;
                    face(ln.sprite, 14 + i, lzs, limg);
                    alpha(ln.sprite, 14 + i, lq * 5);
                } else {
                    limg = ln.img;
                    face(ln.sprite, 14 + i, -2, limg);
                    alpha(ln.sprite, 14 + i, 1);
                    # once the whole name has landed, a hop wave runs along it
                    if (time - TITLE_END - HOP_DELAY >= 0) {
                        hp = (wave - i * 0.07) / 0.4;
                        if (hp > 0 && hp < 1) ly -= sh * 0.022 * Math.Sin(3.14159265 * hp);
                    }
                }
                put(ln.sprite, 14 + i, lx - limg.GetWidth() / 2 + shx, ly - limg.GetHeight() / 2 + shy);
            }
        }
    }

    if (w_badge) {
        # ---- group plate stamps in from the right -------------------------------------------------------
        bt = (time - BADGE_T0) / BADGE_TIME;
        if (bt > 0) {
            be = ease_out_back(clamp01(bt));
            alpha(badge, 23, 1);
            put(badge, 23, sw + (badge_tx - sw) * be + shx, badge_y + shy);
        }
    }

    # ---- damage counter -------------------------------------------------------------------------------------
    if (time >= COUNTER_T0 - 0.05 && (time < COUNTER_T0 + 0.4 || shown != target)) {
        counter_alpha = clamp01((time - COUNTER_T0) / 0.3);
        alpha(label, 24, counter_alpha);
        if (time >= COUNTER_T0) {
            shown += (target - shown) * 0.08;
            if (target - shown < 0.15) shown = target;
            update_counter();
        }
    }

    if (frame % 4 == 1) {
        # ---- sparkles twinkle around the frame and, later, around the title ----------------------------------
        for (i = 0; i < 8; i++) {
            sv = Math.Sin(time * 5 + i * 1.9);
            show = 0;
            if (i < 4 && time >= T_IMP + 0.25) show = 1;
            if (i >= 4 && time >= TITLE_END) show = 1;
            if (show && sv > -0.2) {
                if (sv > 0.55) face(sparks[i], 29 + i, 2, spark_big);
                else face(sparks[i], 29 + i, 1, spark_small);
                alpha(sparks[i], 29 + i, 1);
            } else {
                alpha(sparks[i], 29 + i, 0);
            }
        }
        # frame corners (move with the group) and title corners
        put(sparks[0], 29, panel_x - 8 * k,                         gy + panel_h * 0.12);
        put(sparks[1], 30, panel_x + panel_w - 30 * k,              gy - 22 * k);
        put(sparks[2], 31, panel_x + panel_w - 4 * k,               gy + panel_h * 0.78);
        put(sparks[3], 32, panel_x + panel_w * 0.62,                gy - 30 * k);
        put(sparks[4], 33, title_x - 34 * k,                        title_bottom - 100 * k);
        put(sparks[5], 34, title_x + TITLE_TOTAL * ts * 0.22,       title_y - 4 * k);
        put(sparks[6], 35, title_x + TITLE_TOTAL * ts * 0.78,       title_y + 4 * k);
        put(sparks[7], 36, title_x + TITLE_TOTAL * ts - 4 * k,      title_bottom - 90 * k);
    }
}

Plymouth.SetRefreshFunction(refresh);

# ---- boot progress ------------------------------------------------------------------------------------------------
# Plymouth reports 0..1; the counter eases towards it and never goes backwards.
fun boot_progress(duration, value)
{
    if (value * 100 > target) target = value * 100;
}
Plymouth.SetBootProgressFunction(boot_progress);

# Offline system updates report 0..100 through this one instead; same counter.
fun system_update(progress)
{
    if (progress > target) target = progress;
}
Plymouth.SetSystemUpdateFunction(system_update);

# ---- boot finished -------------------------------------------------------------------------------------------------------
# Plymouth calls this just before it hides the splash. Show a full counter so the
# retained last frame (or the frame the display manager takes over) reads 100%.
fun quit_cb()
{
    target = 100;
    shown = 100;
    shown_last = -1;
    counter_alpha = 1;
    update_counter();
}
Plymouth.SetQuitFunction(quit_cb);

# ---- password / question prompts (encrypted disks) ---------------------------------------------------------------------
# Dark plate with a yellow outline in the middle of the screen, over everything but the CRT effects.
prompt_img = load_img("prompt_plate.png", k);
prompt_plate = make_sprite(prompt_img, 130);
prompt_plate.SetX((sw - prompt_img.GetWidth()) / 2);
prompt_plate.SetY(sh * 0.5 - prompt_img.GetHeight() / 2);
prompt_text = make_sprite(Image.Text(" ", 1, 1, 1), 131);
prompt_entry = make_sprite(Image.Text(" ", 1, 0.9, 0.2), 131);

fun show_prompt(prompt, entry)
{
    local.pi = Image.Text(prompt, 1, 1, 1, 1, "Sans Bold " + Math.Int(30 * k));
    prompt_text.SetImage(local.pi);
    prompt_text.SetX((sw - local.pi.GetWidth()) / 2);
    prompt_text.SetY(sh * 0.5 - prompt_img.GetHeight() * 0.28);
    local.ei = Image.Text(entry, 1, 0.9, 0.2, 1, "Sans Bold " + Math.Int(36 * k));
    prompt_entry.SetImage(local.ei);
    prompt_entry.SetX((sw - local.ei.GetWidth()) / 2);
    prompt_entry.SetY(sh * 0.5 + prompt_img.GetHeight() * 0.02);
    prompt_plate.SetOpacity(1);
    prompt_text.SetOpacity(1);
    prompt_entry.SetOpacity(1);
}

fun display_password(prompt, bullets)
{
    local.dots = "";
    for (local.j = 0; local.j < bullets; local.j++) local.dots += "*";
    show_prompt(prompt, local.dots);
}
fun display_question(prompt, entry)
{
    show_prompt(prompt, entry);
}
fun display_normal()
{
    prompt_plate.SetOpacity(0);
    prompt_text.SetOpacity(0);
    prompt_entry.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayNormalFunction(display_normal);

# ---- status messages (e.g. fsck output) -------------------------------------------------------------------------------------
message_sprite = make_sprite(Image.Text(" ", 1, 1, 1), 132);
fun show_message(text)
{
    local.mi = Image.Text(text, 1, 0.95, 0.6, 1, "Sans Bold " + Math.Int(22 * k));
    message_sprite.SetImage(local.mi);
    message_sprite.SetX((sw - local.mi.GetWidth()) / 2);
    message_sprite.SetY(sh - local.mi.GetHeight() - 26 * k);
    message_sprite.SetOpacity(1);
}
fun hide_message(text)
{
    message_sprite.SetOpacity(0);
}
Plymouth.SetMessageFunction(show_message);
Plymouth.SetHideMessageFunction(hide_message);
