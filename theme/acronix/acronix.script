# generated by scripts/make_assets.sh. Edit theme/acronix.script.in instead.
LOGO_W = 451;
LOGO_H = 279;
PIECE_N_X = 90;
PIECE_N_Y = -4;
PIECE_U_X = -4;
PIECE_U_Y = -4;
PIECE_DOT_X = 372;
PIECE_DOT_Y = -4;
SHINE_FRAMES = 14;
TITLE_N = 9;
TITLE_PAD = 40;
TITLE_ADV[0] = 173;
TITLE_ADV[1] = 138;
TITLE_ADV[2] = 148;
TITLE_ADV[3] = 167;
TITLE_ADV[4] = 164;
TITLE_ADV[5] = 93;
TITLE_ADV[6] = 172;
TITLE_ADV[7] = 167;
TITLE_ADV[8] = 122;
TITLE_TOTAL = 1344;
TITLE_IMG_H = 256;
# Acronix boot splash. The constants above this point (LOGO_W, PIECE_*_X ...)
# are generated by scripts/make_assets.sh, which prepends them to this file.
#
# Three pieces (U, N+stem, dot of the I) fly in from outside the screen,
# spinning slightly, with manga speed lines behind them. When the last one
# lands: white flash, screen shake and a comic burst. Then a gold glint sweeps
# over the logo (and repeats), a glow pulses, the texts fade in and a thin bar
# tracks boot progress.

FPS = 50;           # Plymouth calls the refresh function about 50 times per second
FLY_TIME = 1.2;     # seconds each piece takes to arrive
STAGGER = 0.25;     # seconds between one piece starting and the next

# ---- background -----------------------------------------------------------
# N64 look: saturated blue fading into purple
Window.SetBackgroundTopColor(0.05, 0.14, 0.62);
Window.SetBackgroundBottomColor(0.34, 0.06, 0.48);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# ---- layout ---------------------------------------------------------------
# The logo assembles in the middle of the screen. When the name is about to
# appear, the logo (with its tagline, glow and glint) lifts to the top of the
# screen. Final layout, top to bottom: logo, tagline, project name, group
# badge, progress bar.
# The logo takes about 27% of the screen width (or 32% of the height if the
# screen is very wide).
scale = Math.Min(screen_w * 0.27 / LOGO_W, screen_h * 0.32 / LOGO_H);
logo_w = Math.Int(LOGO_W * scale);
logo_h = Math.Int(LOGO_H * scale);
origin_x = (screen_w - logo_w) / 2;
origin_y = (screen_h - logo_h) / 2;            # where the logo assembles: dead centre
final_y = screen_h * 0.09;                     # where it ends up after the lift
lift_total = final_y - origin_y;               # negative: it moves up

fun load_piece(file, px, py, from_x, from_y, spin, delay)
{
    piece.img = Image(file);
    piece.img = piece.img.Scale(Math.Int(piece.img.GetWidth() * scale),
                                Math.Int(piece.img.GetHeight() * scale));
    piece.sprite = Sprite();
    piece.sprite.SetZ(10);
    piece.tx = origin_x + px * scale;        # final top-left corner
    piece.ty = origin_y + py * scale;
    piece.fx = from_x;                       # where it starts
    piece.fy = from_y;
    piece.spin = spin;                       # starting rotation, in radians
    piece.delay = delay;
    return piece;
}

pieces[0] = load_piece("piece_u.png",   PIECE_U_X,   PIECE_U_Y,
                       -screen_w * 0.5,  origin_y + logo_h * 0.5, -0.9, 0);
pieces[1] = load_piece("piece_n.png",   PIECE_N_X,   PIECE_N_Y,
                       origin_x + logo_w * 0.4,  screen_h * 1.3,   0.7, STAGGER);
pieces[2] = load_piece("piece_dot.png", PIECE_DOT_X, PIECE_DOT_Y,
                       screen_w * 1.3,  -screen_h * 0.3,           2.2, STAGGER * 2);

glow.img = Image("glow.png");
glow.img = glow.img.Scale(Math.Int(logo_w * 1.9), Math.Int(logo_h * 2.2));
glow.sprite = Sprite(glow.img);
logo_cx = origin_x + logo_w / 2;
logo_cy = origin_y + logo_h / 2;
glow_x = logo_cx - glow.img.GetWidth() / 2;
glow_y = logo_cy - glow.img.GetHeight() / 2;
glow.sprite.SetX(glow_x);
glow.sprite.SetY(glow_y);
glow.sprite.SetZ(3);
glow.sprite.SetOpacity(0);

# ---- Smash-style effects --------------------------------------------------
IMPACT_TIME = STAGGER * 2 + FLY_TIME;   # moment the last piece lands
SHAKE_TIME = 0.45;                      # how long the logo shakes
FLASH_TIME = 0.30;                      # how long the white flash lasts
BURST_TIME = 0.55;                      # how long the comic burst lasts
SHINE_DELAY = 0.7;                      # first glint after the impact
SHINE_TIME = 0.8;                       # duration of one glint
SHINE_PERIOD = 3.5;                     # glint repeats this often

# Speed lines: two variants stretched over the screen, behind everything
lines_a.img = Image("lines_a.png").Scale(screen_w, screen_h);
lines_b.img = Image("lines_b.png").Scale(screen_w, screen_h);
lines_a.sprite = Sprite(lines_a.img);
lines_a.sprite.SetZ(2);
lines_a.sprite.SetOpacity(0);

# Comic burst (z=4: behind the logo pieces at z=10, in front of the glow)
burst.img = Image("burst.png");
burst_w = logo_w * 1.5;
burst.sprite = Sprite();
burst.sprite.SetZ(4);
burst.sprite.SetOpacity(0);

# Impact flash: 8x8 white square stretched over the whole screen, on top
flash.sprite = Sprite(Image("flash.png").Scale(screen_w, screen_h));
flash.sprite.SetZ(100);
flash.sprite.SetOpacity(0);

# Shine frames (they include 4 px of padding around the logo, like the pieces)
for (i = 0; i < SHINE_FRAMES; i++) {
    shine_img[i] = Image("shine_" + i + ".png");
    shine_img[i] = shine_img[i].Scale(Math.Int(shine_img[i].GetWidth() * scale),
                                      Math.Int(shine_img[i].GetHeight() * scale));
}
shine.sprite = Sprite(shine_img[0]);
shine.sprite.SetX(origin_x - 4 * scale);
shine_y = origin_y - 4 * scale;
shine.sprite.SetY(shine_y);
shine.sprite.SetZ(11);
shine.sprite.SetOpacity(0);

# ---- texts ----------------------------------------------------------------
# The tagline is glued under the logo: it fades in right after the logo lands
# and then rises together with it (refresh() adds the lift offset to its Y).
TAGLINE = "Líder en Ciencia y Tecnología";
tagline.img = Image.Text(TAGLINE, 1.0, 0.93, 0.55, 1, "Sans Bold " + Math.Int(screen_h / 40));
tagline.sprite = Sprite(tagline.img);
tagline.sprite.SetX((screen_w - tagline.img.GetWidth()) / 2);
tagline_y = origin_y + logo_h + screen_h * 0.035;        # start position (logo centred)
tagline.sprite.SetY(tagline_y);
tagline.sprite.SetZ(10);
tagline.sprite.SetOpacity(0);
tagline_bottom_final = tagline_y + lift_total + tagline.img.GetHeight();

# Project name: nine pre-rendered letters (title_0.png ...), each its own sprite
# so they can drop in one after another. They are scaled to 46% of the screen
# width, or to 13% of its height if that is smaller.
ts = Math.Min(screen_w * 0.46 / TITLE_TOTAL,
              screen_h * 0.13 / (TITLE_IMG_H - 2 * TITLE_PAD));
title_x = (screen_w - TITLE_TOTAL * ts) / 2;
# top of the letter images, so the visible letters start 4% of the height below
# the tagline (at its final, lifted position)
title_y = tagline_bottom_final + screen_h * 0.04 - TITLE_PAD * ts;
title_bottom = title_y + (TITLE_IMG_H - TITLE_PAD) * ts;   # bottom of the visible letters

fun make_letter(i, x)
{
    lett.img = Image("title_" + i + ".png");
    lett.img = lett.img.Scale(Math.Int(lett.img.GetWidth() * ts),
                              Math.Int(lett.img.GetHeight() * ts));
    lett.sprite = Sprite(lett.img);
    lett.sprite.SetX(x);
    lett.sprite.SetZ(12);
    lett.sprite.SetOpacity(0);
    lett.ty = title_y;
    return lett;
}

cursor = title_x;
for (i = 0; i < TITLE_N; i++) {
    letters[i] = make_letter(i, cursor - TITLE_PAD * ts);
    cursor += TITLE_ADV[i] * ts;
}

# Group badge: slides in from the right once the letters have landed. The plate
# starts 30 px into the 250 px canvas, so shift it up to sit just under the title.
badge.img = Image("badge.png");
tb = TITLE_TOTAL * ts * 0.85 / badge.img.GetWidth();     # badge is 85% as wide as the title
badge.img = badge.img.Scale(Math.Int(badge.img.GetWidth() * tb), Math.Int(badge.img.GetHeight() * tb));
badge.sprite = Sprite(badge.img);
badge.tx = (screen_w - badge.img.GetWidth()) / 2;
badge.ty = title_bottom + 26 - 30 * tb;
badge.sprite.SetY(badge.ty);
badge.sprite.SetZ(12);
badge.sprite.SetOpacity(0);

bar_img = Image("bar.png");
bar_y = badge.ty + 222 * tb + screen_h * 0.035;
bar_w_max = logo_w;
bar.sprite = Sprite();
bar.sprite.SetX(origin_x);
bar.sprite.SetY(bar_y);
bar.sprite.SetOpacity(0);

# ---- animation ------------------------------------------------------------
# ease-out-back: fast start, slows down, overshoots the target a little and
# settles back. t goes from 0 to 1, the result from 0 to 1 (peaking above 1).
fun ease_out_back(t)
{
    c1 = 1.70158;
    c3 = c1 + 1;
    u = t - 1;
    return 1 + c3 * u * u * u + c1 * u * u;
}

# ease-out-bounce: falls and bounces three times before resting, like a dropped ball.
fun ease_out_bounce(t)
{
    if (t < 1 / 2.75) return 7.5625 * t * t;
    if (t < 2 / 2.75) { t -= 1.5 / 2.75;   return 7.5625 * t * t + 0.75; }
    if (t < 2.5 / 2.75) { t -= 2.25 / 2.75; return 7.5625 * t * t + 0.9375; }
    t -= 2.625 / 2.75;
    return 7.5625 * t * t + 0.984375;
}

# smooth start and stop (cubic), 0..1 -> 0..1
fun ease_in_out(t)
{
    if (t < 0.5) return 4 * t * t * t;
    u = -2 * t + 2;
    return 1 - u * u * u / 2;
}

# ---- timeline (seconds; IMPACT_TIME is when the last logo piece lands) ----
TAG_T0 = IMPACT_TIME + 0.35;        # tagline fades in under the centred logo
LIFT_T0 = IMPACT_TIME + 1.3;        # logo + tagline rise to the top
LIFT_TIME = 0.75;
LETTER_STAGGER = 0.08;      # seconds between one letter starting to fall and the next
LETTER_TIME = 0.65;         # seconds one letter takes to fall and bounce
LETTER_DROP = screen_h * 0.35;
TITLE_T0 = LIFT_T0 + 0.45;          # letters start dropping while the logo is still rising
TITLE_END = TITLE_T0 + (TITLE_N - 1) * LETTER_STAGGER + LETTER_TIME;
BADGE_T0 = TITLE_T0 + (TITLE_N - 1) * LETTER_STAGGER + 0.15;
BADGE_TIME = 0.7;
HOP_DELAY = 1.0;            # wait after the title lands before the letters start hopping
HOP_PERIOD = 4.0;           # a wave of hops runs along the name this often
HOP_HEIGHT = screen_h * 0.022;

frame = 0;
progress = 0;

fun clamp01(v)
{
    return Math.Max(Math.Min(v, 1), 0);
}

fun refresh()
{
    time = frame / FPS;
    frame++;

    # Seconds since the last piece landed (negative while they are still flying).
    done_time = time - IMPACT_TIME;

    # ---- speed lines: ramp up while the pieces fly, flicker between two
    # variants every 3 frames (like hand-drawn manga lines), cut at impact.
    if (done_time < 0) {
        lines_a.sprite.SetOpacity(clamp01((time - 0.1) / 0.8));
    } else {
        lines_a.sprite.SetOpacity(0);
    }
    if (Math.Int(frame / 3) % 2 == 0) lines_a.sprite.SetImage(lines_a.img);
    else lines_a.sprite.SetImage(lines_b.img);

    # ---- impact: the whole logo shakes, decaying over SHAKE_TIME seconds
    shake_x = 0;
    shake_y = 0;
    if (done_time >= 0 && done_time < SHAKE_TIME) {
        amp = screen_h * 0.016 * (1 - done_time / SHAKE_TIME);
        shake_x = amp * Math.Sin(done_time * 90);
        shake_y = amp * Math.Cos(done_time * 110);
    }

    # ---- lift: how far the logo group (pieces, glow, glint, tagline) has risen
    lift_dy = lift_total * ease_in_out(clamp01((time - LIFT_T0) / LIFT_TIME));

    all_done = 1;
    for (i = 0; i < 3; i++) {
        p = pieces[i];
        t = (time - p.delay) / FLY_TIME;
        if (t < 0) t = 0;
        if (t < 1) all_done = 0; else t = 1;

        e = ease_out_back(t);
        x = p.fx + (p.tx - p.fx) * e;
        y = p.fy + (p.ty - p.fy) * e;
        angle = p.spin * (1 - e);

        # Rotate around the piece's centre: the rotated image changes size, so
        # place it by its centre rather than its corner.
        if (t < 1) img = p.img.Rotate(angle); else img = p.img;
        cx = x + p.img.GetWidth() / 2;
        cy = y + p.img.GetHeight() / 2;
        p.sprite.SetImage(img);
        p.sprite.SetX(cx - img.GetWidth() / 2 + shake_x);
        p.sprite.SetY(cy - img.GetHeight() / 2 + shake_y + lift_dy);
    }

    if (all_done) {
        # Glow fades in, then breathes slowly.
        fade = Math.Min(done_time / 0.8, 1);
        pulse = 0.55 + 0.35 * Math.Sin(done_time * 2.4);
        glow.sprite.SetOpacity(fade * pulse);
        glow.sprite.SetX(glow_x + shake_x);
        glow.sprite.SetY(glow_y + shake_y + lift_dy);

        # White flash: full screen, drops off quickly (squared = sharp fall).
        f = clamp01(1 - done_time / FLASH_TIME);
        flash.sprite.SetOpacity(f * f);

        # Comic burst behind the logo: pops out from 35% to 130% size while fading.
        b = clamp01(done_time / BURST_TIME);
        if (b < 1) {
            bs = 0.35 + 0.95 * (1 - (1 - b) * (1 - b));
            bw = Math.Int(burst_w * bs);
            bimg = burst.img.Scale(bw, bw);
            burst.sprite.SetImage(bimg);
            burst.sprite.SetX(logo_cx - bw / 2 + shake_x);
            burst.sprite.SetY(logo_cy - bw / 2 + shake_y);
            burst.sprite.SetOpacity(1 - b * b);
        } else {
            burst.sprite.SetOpacity(0);
        }

        # Gold glint sweeps across the logo shortly after landing, then again
        # every SHINE_PERIOD seconds.
        ph = done_time - SHINE_DELAY;
        shine.sprite.SetOpacity(0);
        shine.sprite.SetY(shine_y + lift_dy);
        if (ph >= 0) {
            ph = ph - Math.Int(ph / SHINE_PERIOD) * SHINE_PERIOD;
            if (ph < SHINE_TIME) {
                k = Math.Int(ph / SHINE_TIME * SHINE_FRAMES);
                shine.sprite.SetImage(shine_img[k]);
                shine.sprite.SetOpacity(1);
            }
        }

        # progress bar only appears once the final layout is in place
        bar.sprite.SetOpacity(clamp01((time - LIFT_T0 - LIFT_TIME) / 0.5));

        # ---- project name: letters fall in from above one after another
        wave = time - TITLE_END - HOP_DELAY;
        if (wave >= 0) wave = wave - Math.Int(wave / HOP_PERIOD) * HOP_PERIOD;
        for (i = 0; i < TITLE_N; i++) {
            ln = letters[i];
            lt = (time - TITLE_T0 - i * LETTER_STAGGER) / LETTER_TIME;
            if (lt <= 0) {
                ln.sprite.SetOpacity(0);
            } else {
                ln.sprite.SetOpacity(clamp01(lt * 10));
                ly = ln.ty - (1 - ease_out_bounce(clamp01(lt))) * LETTER_DROP;
                # once settled, a hop runs along the letters like a wave
                if (lt >= 1 && time - TITLE_END - HOP_DELAY >= 0) {
                    hp = (wave - i * 0.07) / 0.4;
                    if (hp > 0 && hp < 1) ly -= HOP_HEIGHT * Math.Sin(3.14159265 * hp);
                }
                ln.sprite.SetY(ly);
            }
        }

        # ---- group badge: slides in from the right and overshoots a little
        bt = (time - BADGE_T0) / BADGE_TIME;
        if (bt > 0) {
            be = ease_out_back(clamp01(bt));
            badge.sprite.SetX(screen_w + (badge.tx - screen_w) * be);
            badge.sprite.SetOpacity(1);
        }

        # tagline: fades in right under the centred logo, then rises with it
        tagline.sprite.SetOpacity(clamp01((time - TAG_T0) / 0.5));
        tagline.sprite.SetY(tagline_y + lift_dy);
    }
}

Plymouth.SetRefreshFunction(refresh);

# ---- boot progress --------------------------------------------------------
fun boot_progress(duration, value)
{
    # Never move the bar backwards, and always show at least a sliver.
    if (value > progress) progress = value;
    w = Math.Max(Math.Int(bar_w_max * progress), 4);
    bar.sprite.SetImage(bar_img.Scale(w, 4));
}

Plymouth.SetBootProgressFunction(boot_progress);

# ---- password prompt (needed for encrypted disks) -------------------------
prompt_sprite = Sprite();
bullets_sprite = Sprite();

fun display_password(prompt, bullets)
{
    label = Image.Text(prompt, 0.86, 0.92, 1.0);
    prompt_sprite.SetImage(label);
    prompt_sprite.SetX((screen_w - label.GetWidth()) / 2);
    prompt_sprite.SetY(bar_y + screen_h * 0.06);

    dots = "";
    for (i = 0; i < bullets; i++) dots += "*";
    dots_img = Image.Text(dots, 0.86, 0.92, 1.0);
    bullets_sprite.SetImage(dots_img);
    bullets_sprite.SetX((screen_w - dots_img.GetWidth()) / 2);
    bullets_sprite.SetY(bar_y + screen_h * 0.06 + label.GetHeight() + 8);
}

fun display_normal()
{
    prompt_sprite.SetOpacity(0);
    bullets_sprite.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
