[Plymouth Theme]
Name=Acronix
Description=UNI logo pieces fly in and assemble while the system boots
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/acronix
ScriptFile=/usr/share/plymouth/themes/acronix/acronix.script
ConsoleLogBackgroundColor=0x0b1b3f
MonospaceFont=Cantarell 11
Font=Cantarell 12
