# generated by scripts/make_assets_cosmos.py. Edit theme/acronixcosmos.script.in instead.
LOGO_AW = 84;
LOGO_AH = 53;
GLOW_PAD = 8;
PIECE_U_AX = 0;
PIECE_U_AY = 0;
PIECE_N_AX = 17;
PIECE_N_AY = 0;
PIECE_DOT_AX = 68;
PIECE_DOT_AY = 0;
TITLE_N = 9;
TITLE_TOTAL = 153;
TITLE_MARGIN = 4;
TITLE_X[0] = 0;
TITLE_X[1] = 18;
TITLE_X[2] = 36;
TITLE_X[3] = 54;
TITLE_X[4] = 72;
TITLE_X[5] = 90;
TITLE_X[6] = 102;
TITLE_X[7] = 120;
TITLE_X[8] = 138;
MOON_X = 254;
MOON_Y = 34;
SCALES[0] = 3; SCALES[1] = 4; SCALES[2] = 5; SCALES[3] = 6; SCALES[4] = 8;
N_SCALES = 5;

# AcronixOS cosmic pixel-art boot theme.
# The constants above this line are generated by scripts/make_assets_cosmos.py.
#
# All art lives on a 320x180 grid of "art pixels". The images were already
# enlarged by a whole number S (nearest neighbour) at build time, so nothing is
# ever resized here and the pixels stay sharp. S is the smallest of SCALES that
# covers the screen; if the screen is not 16:9 the picture is centred and the
# edges are cropped (nothing important lives near the edges).

sw = Window.GetWidth();
sh = Window.GetHeight();
Window.SetBackgroundTopColor(0.008, 0.004, 0.04);
Window.SetBackgroundBottomColor(0.008, 0.004, 0.04);

need = Math.Max(sw / 320, sh / 180);
S = SCALES[N_SCALES - 1];
for (i = N_SCALES - 1; i >= 0; i--) {
    if (SCALES[i] >= need) S = SCALES[i];
}
ox = Math.Int((sw - 320 * S) / 2);
oy = Math.Int((sh - 180 * S) / 2);
k = sh / 1080;                       # only used for the (smooth) system fonts

fun gx(v) { return ox + Math.Int(v * S); }
fun gy(v) { return oy + Math.Int(v * S); }
fun load(name) { return Image("s" + S + "_" + name + ".png"); }
fun clamp01(v) { return Math.Max(Math.Min(v, 1), 0); }
fun ease_out_back(v)
{
    local.u = clamp01(v) - 1;
    return 1 + 2.70158 * local.u * local.u * local.u + 1.70158 * local.u * local.u;
}

# ---- sprites -------------------------------------------------------------------
# Plymouth repaints a sprite's whole area on ANY setter call, even with the same
# value, so every update goes through these helpers which only call the real
# setter when something changed. Sprites are addressed by number.
# arrays must exist globally before a function first writes to them, otherwise
# the function creates its own private copy and the sprites vanish with it
spr[0] = 0; last_x[0] = 0; last_y[0] = 0; last_o[0] = 0; last_key[0] = 0;
nid = 0;
fun add(im, z)
{
    local.n = nid;
    spr[local.n] = Sprite(im);
    spr[local.n].SetZ(z);
    spr[local.n].SetOpacity(0);
    last_x[local.n] = -99999; last_y[local.n] = -99999; last_o[local.n] = -1; last_key[local.n] = -1;
    nid++;
    return local.n;
}
fun put(n, x, y)
{
    local.xi = Math.Int(x);
    local.yi = Math.Int(y);
    if (local.xi != last_x[n] || local.yi != last_y[n]) {
        spr[n].SetX(local.xi);
        spr[n].SetY(local.yi);
        last_x[n] = local.xi;
        last_y[n] = local.yi;
    }
}
# opacity in `steps` steps (few steps for big sprites: each step is a repaint)
fun alphaq(n, v, steps)
{
    local.q = Math.Int(clamp01(v) * steps + 0.5);
    if (local.q != last_o[n]) {
        spr[n].SetOpacity(local.q / steps);
        last_o[n] = local.q;
    }
}
fun alpha(n, v) { alphaq(n, v, 20); }
fun face(n, key, im)
{
    if (key != last_key[n]) {
        spr[n].SetImage(im);
        last_key[n] = key;
    }
}
# image swap that keeps the image centred on (cx, cy) in screen pixels
fun face_center(n, key, im, cx, cy)
{
    if (key != last_key[n]) {
        spr[n].SetImage(im);
        last_key[n] = key;
        spr[n].SetX(Math.Int(cx - im.GetWidth() / 2));
        spr[n].SetY(Math.Int(cy - im.GetHeight() / 2));
    }
}

# ---- scenery -----------------------------------------------------------------------
Z_BG = 0; Z_NEB = 1; Z_MOON = 2; Z_CMID = 3; Z_CFRONT = 4; Z_SPARK = 5; Z_STAR = 6;
Z_GLOW = 7; Z_LOGO = 8; Z_TEXT = 9; Z_TRACK = 10; Z_TITLE = 11; Z_PROMPT = 30;

bg = add(load("bg"), Z_BG);
put(bg, ox, oy);

neb_img[0] = load("neb_a0"); neb_img[1] = load("neb_a1"); neb_img[2] = load("neb_a2");
neb_img[3] = load("neb_b0"); neb_img[4] = load("neb_b1"); neb_img[5] = load("neb_b2");
neb_a = add(neb_img[0], Z_NEB); put(neb_a, gx(0), gy(0));
neb_b = add(neb_img[3], Z_NEB); put(neb_b, gx(170), gy(30));

for (b = 0; b < 3; b++) {
    for (f = 0; f < 2; f++) moon_img[b * 2 + f] = load("moon_" + b + f);
}
moon_cx = gx(MOON_X);
moon_cy = gy(MOON_Y);
moon = add(moon_img[2], Z_MOON);
face_center(moon, 2, moon_img[2], moon_cx, moon_cy);

cloud_mid = add(load("cloud_mid"), Z_CMID);
cloud_front = add(load("cloud_front"), Z_CFRONT);
put(cloud_mid, ox, gy(140));
put(cloud_front, ox, gy(158));

# twinkling stars: 0 = dot, 1 = small cross, 2 = long cross
for (p = 0; p < 2; p++) {
    for (f = 0; f < 3; f++) spark_img[p * 3 + f] = load("spark" + p + "_" + f);
}
sx = [52, 96, 104, 150, 186, 208, 278, 292, 30, 20, 300, 44, 112, 206];
sy = [60, 18,  52,  14,  12,  24,  60,  96, 92, 120, 120, 76,  26,  52];
N_SPARK = 14;
for (i = 0; i < N_SPARK; i++) {
    spark[i] = add(spark_img[(i % 2) * 3], Z_SPARK);
    put(spark[i], gx(sx[i]) - 3 * S, gy(sy[i]) - 3 * S);
}
# big five-point stars (Kirby-like): 3 sizes, twinkle by growing and shrinking
for (f = 0; f < 3; f++) bstar_img[f] = load("bstar_" + f);
bx = [28, 88, 214, 300, 40, 296];
by = [18, 12,  12,  22, 78,  70];
N_BSTAR = 6;
for (i = 0; i < N_BSTAR; i++) {
    bstar[i] = add(bstar_img[0], Z_SPARK);
    put(bstar[i], gx(bx[i]) - 9 * S, gy(by[i]) - 9 * S);
}
# small spiral galaxies, three frames each (arms turn slowly)
for (g = 0; g < 3; g++) {
    for (f = 0; f < 3; f++) gal_img[g * 3 + f] = load("gal" + g + "_" + f);
}
galx = [36, 287, 166];
galy = [50, 104, 12];
for (g = 0; g < 3; g++) {
    gal[g] = add(gal_img[g * 3], Z_SPARK);
    face_center(gal[g], g * 3, gal_img[g * 3], gx(galx[g]), gy(galy[g]));
}
# shooting stars: right-moving and left-moving, two frames each (head twinkles)
for (f = 0; f < 2; f++) { shoot_img[f] = load("shoot_r" + f); shoot_img[2 + f] = load("shoot_l" + f); }
ss[0] = add(shoot_img[0], Z_SPARK);
ss[1] = add(shoot_img[2], Z_SPARK);
ss_x0[0] = -30; ss_y0[0] = 6;  ss_x1[0] = 100; ss_y1[0] = 54;
ss_x0[1] = 340; ss_y0[1] = 8;  ss_x1[1] = 215; ss_y1[1] = 60;
ss_t0[0] = 2.6; ss_t0[1] = 5.4;
ss_period[0] = 6.5; ss_period[1] = 8.7;
SS_DUR = 1.0;

# six more that only twinkle around the AcronixOS title
tx = [84, 238, 110, 212, 160, 264];
ty = [40,  34,  70,  68,  22,  58];
N_TSPARK = 6;
for (i = 0; i < N_TSPARK; i++) {
    tspark[i] = add(spark_img[((i + 1) % 2) * 3], Z_TITLE);
    put(tspark[i], gx(tx[i]) - 3 * S, gy(ty[i]) - 3 * S);
}

# ---- UNI logo (exact geometry, only recoloured) ----------------------------------------
logo_x = gx(160 - LOGO_AW / 2);
logo_y = gy(28);
piece_img[0] = load("piece_u"); piece_img[1] = load("piece_n"); piece_img[2] = load("piece_dot");
piece_tx[0] = logo_x + PIECE_U_AX * S;   piece_ty[0] = logo_y + PIECE_U_AY * S;
piece_tx[1] = logo_x + PIECE_N_AX * S;   piece_ty[1] = logo_y + PIECE_N_AY * S;
piece_tx[2] = logo_x + PIECE_DOT_AX * S; piece_ty[2] = logo_y + PIECE_DOT_AY * S;
# where each piece comes from (offset from its place) and when it arrives
piece_dx[0] = -sw * 0.7; piece_dy[0] = sh * 0.05;
piece_dx[1] = 0;         piece_dy[1] = -sh * 0.9;
piece_dx[2] = sw * 0.6;  piece_dy[2] = sh * 0.35;
piece_t0[0] = 1.8; piece_t0[1] = 2.1; piece_t0[2] = 2.4;
PIECE_FLY = 1.2;
for (i = 0; i < 3; i++) {
    piece[i] = add(piece_img[i], Z_LOGO);
    put(piece[i], piece_tx[i] + piece_dx[i], piece_ty[i] + piece_dy[i]);
}
glow_img = load("logo_glow");
glow = add(glow_img, Z_GLOW);
put(glow, logo_x - GLOW_PAD * S, logo_y - GLOW_PAD * S);
T_ASSEMBLED = 3.6;
T_OUT = 6.3;                         # when the UNI group makes way for AcronixOS

txt_uni_img = load("txt_uni");
txt_grp_img = load("txt_grp");
txt_tag_img = load("txt_tag");
txt_uni = add(txt_uni_img, Z_TEXT);
txt_grp = add(txt_grp_img, Z_TEXT);
txt_tag = add(txt_tag_img, Z_TEXT);
put(txt_uni, ox + (320 * S - txt_uni_img.GetWidth()) / 2, gy(86));
put(txt_grp, ox + (320 * S - txt_grp_img.GetWidth()) / 2, gy(98));
put(txt_tag, ox + (320 * S - txt_tag_img.GetWidth()) / 2, gy(80));

# ---- progress: a path of stars that light up one by one -------------------------------------
N_SLOT = 16;
slot_off = load("slot_off");
slot_on = load("slot_on");
head_img[0] = load("head_0"); head_img[1] = load("head_1");
for (i = 0; i < N_SLOT; i++) {
    slot_x[i] = gx(104 + i * 7.4);
    slot_y[i] = gy(121 + 2.5 * Math.Sin(i * 0.8));
    slot[i] = add(slot_off, Z_TRACK);
    put(slot[i], slot_x[i] - 4 * S, slot_y[i] - 4 * S);
}
head = add(head_img[0], Z_TRACK + 1);
for (i = 0; i < 4; i++) load_img[i] = load("txt_load" + i);
label = add(load_img[0], Z_TRACK);
put(label, ox + (320 * S - load_img[3].GetWidth()) / 2, gy(129));

target = 0;        # 0..1 reported by Plymouth
shown = 0;         # eased towards target, never goes back
n_lit = 0;
lit_done = 0;

fun update_slots()
{
    local.want = Math.Int(shown * N_SLOT + 0.5);
    local.want = Math.Max(Math.Min(local.want, N_SLOT), 0);
    for (local.j = lit_done; local.j < local.want; local.j++) face(slot[local.j], 1, slot_on);
    lit_done = Math.Max(lit_done, local.want);
    n_lit = lit_done;
}

# ---- AcronixOS title ----------------------------------------------------------------------------------
star_img[0] = load("star_0"); star_img[1] = load("star_1"); star_img[2] = load("star_2");
star_img[3] = load("star_3"); star_img[4] = load("star_4"); star_img[5] = load("star_5");
star_img[6] = load("star_6");
star = add(star_img[0], Z_STAR);
star_cx = gx(160);
star_cy = gy(51);
T_TITLE = 6.9;
title_x0 = (320 - TITLE_TOTAL) / 2;
for (i = 0; i < TITLE_N; i++) {
    title_img[i] = load("title_" + i);
    title[i] = add(title_img[i], Z_TITLE);
    title_px[i] = gx(title_x0 + TITLE_X[i] - TITLE_MARGIN);
    put(title[i], title_px[i], gy(34 - 8));
}
title_drop[0] = -8; title_drop[1] = -4; title_drop[2] = -1; title_drop[3] = 0;

# ---- main loop -----------------------------------------------------------------------------------------------------
frame = 0;
fun refresh()
{
    frame++;
    if (frame % 2 == 0) return 0;          # 25 updates per second is plenty for pixel art
    t = frame / 50;

    # sky: fades in from black, in a few big steps (a full-screen repaint is expensive)
    local.sky = Math.Int(clamp01(t / 1.6) * 8) / 8;
    alphaq(bg, local.sky, 8);
    alphaq(neb_a, local.sky, 8);
    alphaq(neb_b, local.sky, 8);
    alphaq(cloud_mid, local.sky, 8);
    alphaq(cloud_front, local.sky, 8);
    if (t < 1.8) return 0;

    # nebula shimmer (3 frames, 1 step every 0.8 s) and cloud drift (art pixels, wrap at 320)
    local.nf = Math.Int(t / 0.8) % 3;
    face(neb_a, local.nf, neb_img[local.nf]);
    face(neb_b, local.nf, neb_img[3 + local.nf]);
    put(cloud_mid,   ox - (Math.Int(t / 1.0) % 320) * S, gy(140));
    put(cloud_front, ox - (Math.Int(t / 0.5) % 320) * S, gy(158));

    # moon: fades in, brightens with progress, gentle flicker
    local.mb = 0;
    if (shown > 0.33) local.mb = 1;
    if (shown > 0.66) local.mb = 2;
    local.mi = local.mb * 2 + Math.Int(t / 0.7) % 2;
    face_center(moon, local.mi, moon_img[local.mi], moon_cx, moon_cy);
    alphaq(moon, clamp01((t - (1.4)) / 0.9), 6);

    # twinkling stars; more of them appear as boot progresses
    local.show = 8 + Math.Int(shown * 12);
    for (local.j = 0; local.j < N_SPARK; local.j++) {
        if (local.j < local.show) {
            local.ph = (Math.Int(t * 2.5) + local.j * 5) % 8;
            local.fr = 0;
            if (local.ph == 3 || local.ph == 5) local.fr = 1;
            if (local.ph == 4) local.fr = 2;
            face(spark[local.j], local.fr, spark_img[(local.j % 2) * 3 + local.fr]);
            alpha(spark[local.j], clamp01((t - (1.9 + local.j * 0.05)) / 0.4));
        }
    }

    # big five-point stars twinkle
    for (local.j = 0; local.j < N_BSTAR; local.j++) {
        local.ph = (Math.Int(t * 1.6) + local.j * 3) % 4;
        local.fr = local.ph;
        if (local.ph == 3) local.fr = 1;
        face(bstar[local.j], local.fr, bstar_img[local.fr]);
        alpha(bstar[local.j], clamp01((t - (2.0 + local.j * 0.15)) / 0.5));
    }

    # galaxies: arms turn one frame at a time
    for (local.j = 0; local.j < 3; local.j++) {
        local.gf = (Math.Int(t / 0.9) + local.j) % 3;
        face_center(gal[local.j], local.j * 3 + local.gf, gal_img[local.j * 3 + local.gf], gx(galx[local.j]), gy(galy[local.j]));
        alpha(gal[local.j], clamp01((t - (2.2 + local.j * 0.3)) / 0.6));
    }

    # shooting stars cross the sky now and then
    for (local.j = 0; local.j < 2; local.j++) {
        local.sp = t - ss_t0[local.j];
        local.cyc = -1;
        if (local.sp >= 0) local.cyc = local.sp - Math.Int(local.sp / ss_period[local.j]) * ss_period[local.j];
        if (local.cyc >= 0 && local.cyc < SS_DUR) {
            local.u = local.cyc / SS_DUR;
            local.sf = Math.Int(t * 8) % 2;
            face(ss[local.j], local.sf, shoot_img[local.j * 2 + local.sf]);
            put(ss[local.j], gx(ss_x0[local.j] + (ss_x1[local.j] - ss_x0[local.j]) * local.u),
                             gy(ss_y0[local.j] + (ss_y1[local.j] - ss_y0[local.j]) * local.u));
            alphaq(ss[local.j], 1, 1);
        } else {
            alphaq(ss[local.j], 0, 1);
        }
    }

    # logo pieces fly in from different sides and snap together
    for (local.j = 0; local.j < 3; local.j++) {
        local.e = ease_out_back(clamp01((t - (piece_t0[local.j])) / PIECE_FLY));
        put(piece[local.j], piece_tx[local.j] + piece_dx[local.j] * (1 - local.e),
                            piece_ty[local.j] + piece_dy[local.j] * (1 - local.e));
        alpha(piece[local.j], clamp01((t - (piece_t0[local.j])) / 0.25) * (1 - clamp01((t - (T_OUT)) / 0.6)));
    }
    local.g = 0;
    if (t > T_ASSEMBLED) local.g = Math.Sin(clamp01((t - T_ASSEMBLED) / 1.0) * Math.Pi);
    alpha(glow, local.g * (1 - clamp01((t - (T_OUT)) / 0.6)));

    # institutional texts, one after another
    alpha(txt_uni, clamp01((t - (3.9)) / 0.5) * (1 - clamp01((t - (T_OUT)) / 0.6)));
    alpha(txt_grp, clamp01((t - (4.5)) / 0.5) * (1 - clamp01((t - (T_OUT)) / 0.6)));

    # progress path
    alpha(label, clamp01((t - (5.0)) / 0.5));
    face(label, 100 + Math.Int(t / 0.45) % 4, load_img[Math.Int(t / 0.45) % 4]);
    for (local.j = 0; local.j < N_SLOT; local.j++) alpha(slot[local.j], clamp01((t - (5.0 + local.j * 0.01)) / 0.5));
    local.hi = Math.Min(n_lit, N_SLOT - 1);
    put(head, slot_x[local.hi] - 8 * S, slot_y[local.hi] - 8 * S);
    face(head, Math.Int(t * 4) % 2, head_img[Math.Int(t * 4) % 2]);
    alpha(head, clamp01((t - (5.0)) / 0.5));

    # AcronixOS: the star rises behind, letters drop in, tagline, twinkles around
    if (t >= T_TITLE) {
        local.sf = Math.Int((t - T_TITLE) / 0.12);
        if (local.sf > 4) {
            local.pf = Math.Int((t - T_TITLE - 0.6) / 0.5) % 4;
            local.sf = 4;
            if (local.pf == 1) local.sf = 5;
            if (local.pf == 3) local.sf = 6;
        }
        face_center(star, local.sf, star_img[local.sf], star_cx, star_cy);
        alphaq(star, 1, 1);
        for (local.j = 0; local.j < TITLE_N; local.j++) {
            local.ts = T_TITLE + 0.5 + local.j * 0.14;
            local.st = Math.Int((t - local.ts) / 0.07);
            if (local.st >= 0) {
                local.d = 0;
                if (local.st < 4) local.d = title_drop[local.st];
                put(title[local.j], title_px[local.j], gy(34 + local.d));
                alphaq(title[local.j], 1, 1);
            }
        }
        alpha(txt_tag, clamp01((t - (T_TITLE + 2.0)) / 0.6));
        for (local.j = 0; local.j < N_TSPARK; local.j++) {
            local.ph = (Math.Int(t * 2.2) + local.j * 3) % 7;
            local.fr = 0;
            if (local.ph == 2 || local.ph == 4) local.fr = 1;
            if (local.ph == 3) local.fr = 2;
            face(tspark[local.j], local.fr, spark_img[((local.j + 1) % 2) * 3 + local.fr]);
            alpha(tspark[local.j], clamp01((t - (T_TITLE + 1.0 + local.j * 0.1)) / 0.4));
        }
    }

    # ease the progress and light the stars
    shown = shown + Math.Min((target - shown) * 0.12, 0.02);
    if (target - shown < 0.004) shown = Math.Max(shown, target);
    update_slots();
}
Plymouth.SetRefreshFunction(refresh);

# ---- boot progress -----------------------------------------------------------------------------------------------------------
# Plymouth reports 0..1 (an estimate based on previous boots); never goes backwards.
fun boot_progress(duration, value)
{
    if (value > target) target = value;
}
Plymouth.SetBootProgressFunction(boot_progress);

# Offline system updates report 0..100 through this one instead.
fun system_update(progress)
{
    if (progress / 100 > target) target = progress / 100;
}
Plymouth.SetSystemUpdateFunction(system_update);

# ---- boot finished -------------------------------------------------------------------------------------------------------------------
# Plymouth calls this just before it hides the splash; leave the path full so the
# last frame handed to the login screen reads "done".
fun quit_cb()
{
    target = 1;
    shown = 1;
    update_slots();
}
Plymouth.SetQuitFunction(quit_cb);

# ---- password / question prompts (encrypted disks) ----------------------------------------------------------------
plate_img = load("plate");
plate = add(plate_img, Z_PROMPT);
put(plate, ox + (320 * S - plate_img.GetWidth()) / 2, gy(90) - plate_img.GetHeight() / 2);
prompt_text = add(Image.Text(" ", 1, 1, 1), Z_PROMPT + 1);
prompt_entry = add(Image.Text(" ", 1, 1, 1), Z_PROMPT + 1);

fun show_prompt(prompt, entry)
{
    local.pi = Image.Text(prompt, 1, 1, 1, 1, "Sans Bold " + Math.Int(24 * k));
    spr[prompt_text].SetImage(local.pi);
    put(prompt_text, (sw - local.pi.GetWidth()) / 2, gy(90) - plate_img.GetHeight() * 0.36);
    local.ei = Image.Text(entry, 1, 0.85, 0.45, 1, "Sans Bold " + Math.Int(30 * k));
    spr[prompt_entry].SetImage(local.ei);
    spr[prompt_entry].SetX((sw - local.ei.GetWidth()) / 2);
    spr[prompt_entry].SetY(gy(90) + plate_img.GetHeight() * 0.02);
    last_x[prompt_entry] = -99999;
    spr[plate].SetOpacity(1);
    spr[prompt_text].SetOpacity(1);
    spr[prompt_entry].SetOpacity(1);
}
fun display_password(prompt, bullets)
{
    local.dots = "";
    for (local.j = 0; local.j < bullets; local.j++) local.dots += "*";
    show_prompt(prompt, local.dots);
}
fun display_question(prompt, entry)
{
    show_prompt(prompt, entry);
}
fun display_normal()
{
    spr[plate].SetOpacity(0);
    spr[prompt_text].SetOpacity(0);
    spr[prompt_entry].SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayNormalFunction(display_normal);

# ---- status messages (e.g. fsck output) ----------------------------------------------------------------------------------------
message_sprite = add(Image.Text(" ", 1, 1, 1), Z_PROMPT + 2);
fun show_message(text)
{
    local.mi = Image.Text(text, 1, 0.95, 0.75, 1, "Sans Bold " + Math.Int(18 * k));
    spr[message_sprite].SetImage(local.mi);
    spr[message_sprite].SetX((sw - local.mi.GetWidth()) / 2);
    spr[message_sprite].SetY(sh - local.mi.GetHeight() - 14 * S);
    spr[message_sprite].SetOpacity(1);
}
fun hide_message(text)
{
    spr[message_sprite].SetOpacity(0);
}
Plymouth.SetMessageFunction(show_message);
Plymouth.SetHideMessageFunction(hide_message);
